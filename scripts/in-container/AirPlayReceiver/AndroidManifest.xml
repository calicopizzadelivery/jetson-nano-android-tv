<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.tv.airplay">

    <!-- The AirPlay server listens for senders and advertises over mDNS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bringing the mirroring screen up from the service when a Mac or
         iPhone starts mirroring. Privileged, so allowlisted. -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Starting the screensaver when a stream begins on the home screen.
         Both are privileged, so both are in the privapp allowlist. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.WRITE_DREAM_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Exported so the panel tile can start and stop it. -->
        <service
            android:name=".AirPlayService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <!-- specialUse, not mediaPlayback. Android 15 refuses a
                 mediaPlayback foreground service started from BOOT_COMPLETED
                 (ForegroundServiceStartNotAllowedException), so the boot
                 receiver crashed the service twice and ActivityManager backed
                 off for thirty minutes, leaving the daemon running with nothing
                 holding focus or publishing metadata. It is also the more
                 honest type: this service spends nearly all its time waiting
                 for a sender, and the audio is played by the native daemon,
                 not by this app. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="AirPlay receiver: listens for streams on the local network" />
            <intent-filter>
                <action android:name="org.lineageos.tv.airplay.START" />
                <action android:name="org.lineageos.tv.airplay.STOP" />
            </intent-filter>
        </service>

        <!-- What a mirrored screen is shown on. Not exported: only the
             service starts it. -->
        <activity
            android:name=".MirrorActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- The pairing code, over whatever is on screen. Not exported: only
             the service starts it. -->
        <activity
            android:name=".PinActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />

        <!-- The PIN setting and the paired devices, for the launcher's
             Streaming tile. Same permission as the service; call() checks
             it again, because the platform does not apply it to call(). -->
        <provider
            android:name=".AirPlaySettingsProvider"
            android:authorities="org.lineageos.tv.airplay.settings"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
