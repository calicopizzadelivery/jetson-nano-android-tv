<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.tv.airplay">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- Exported so the panel tile can start and stop it. -->
        <service
            android:name=".AirPlayService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="org.lineageos.tv.airplay.START" />
                <action android:name="org.lineageos.tv.airplay.STOP" />
            </intent-filter>
        </service>

    </application>
</manifest>
