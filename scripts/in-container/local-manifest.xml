<?xml version="1.0" encoding="UTF-8"?>
<!--
     SPDX-FileCopyrightText: 2026 The LineageOS Project
     SPDX-License-Identifier: Apache-2.0

     Installed into .repo/local_manifests/zz-jetson-tv.xml by
     scripts/in-container/local-manifest.xml by scripts/in-container/local-manifest.sh.

     The "zz-" prefix is load-bearing. repo reads local manifests in sorted
     order, and remove-project only removes what has already been defined, so
     this has to sort after roomservice.xml — which is where device/nvidia/porg
     comes from.

     remove-project is optional="true" on purpose: on a cold tree roomservice
     has not run yet and porg is in no manifest, and without it repo aborts
     with "remove-project element specifies non-existent project".

     The github remote fetches from ".." relative to the manifest repo
     (LineageOS/android.git), which resolves to https://github.com/ — so a fork
     is just a different name on the same remote.
-->
<manifest>

  <remove-project path="device/nvidia/porg" optional="true" />
  <project path="device/nvidia/porg" remote="github"
           name="calicopizzadelivery/android_device_nvidia_porg"
           revision="refs/heads/lineage-22.2-jetson-tv" />

  <remove-project path="packages/apps/TvSettings" optional="true" />
  <project path="packages/apps/TvSettings" remote="github"
           name="calicopizzadelivery/android_packages_apps_TvSettings"
           revision="refs/heads/lineage-22.2-jetson-tv" />

  <remove-project path="packages/apps/Catapult" optional="true" />
  <project path="packages/apps/Catapult" remote="github"
           name="calicopizzadelivery/android_packages_apps_Catapult"
           revision="refs/heads/lineage-22.2-jetson-tv" />

  <!-- The ATV device config, for one line: its config_deviceKeyHandler*
       arrays. They are single resources, so a product overlay replaces them
       wholesale rather than appending, and a product overlay listed after
       this one does not win. Our third handler therefore has to live in the
       file itself. -->
  <remove-project path="device/lineage/atv" optional="true" />
  <project path="device/lineage/atv" remote="github"
           name="calicopizzadelivery/android_device_lineage_atv"
           revision="refs/heads/lineage-22.2-jetson-tv" />

  <remove-project path="device/nvidia/tegra-common" optional="true" />
  <project path="device/nvidia/tegra-common" remote="github"
           name="calicopizzadelivery/android_device_nvidia_tegra-common"
           revision="refs/heads/lineage-22.2-jetson-tv" />

  <!-- The kernel tracks lineage-22.2_4.9 upstream, not lineage-22.2, so our
       branch is named after the branch it forks. -->
  <remove-project path="kernel/nvidia/kernel-4.9" optional="true" />
  <project path="kernel/nvidia/kernel-4.9" remote="github"
           name="calicopizzadelivery/android_kernel_nvidia_kernel"
           revision="refs/heads/lineage-22.2_4.9-jetson-tv" />

  <!-- AirPlay audio receiver. Not an upstream LineageOS project at all: these
       two are forks of their own upstreams carrying an Android port on the
       android-jetson-tv branch, so there is nothing to remove-project first.
       popt is here because shairport-sync requires it unconditionally and AOSP
       does not ship it; libconfig and mbedtls it needs are already in-tree. -->
  <project path="external/shairport-sync" remote="github"
           name="calicopizzadelivery/shairport-sync"
           revision="refs/heads/android-jetson-tv" />
  <project path="external/popt" remote="github"
           name="calicopizzadelivery/popt"
           revision="refs/heads/android-jetson-tv" />

  <!-- AirPlay mirroring and audio receiver, which replaced shairport-sync
       above (still synced, no longer built). UxPlay is GPLv3 and links the
       platform's BoringSSL as the system crypto library; libplist
       (LGPL-2.1+) is here because UxPlay needs it and AOSP does not ship it.
       Both carry an Android port on android-jetson-tv, branched from the
       pinned upstream releases v1.73.7 and 2.7.0. -->
  <project path="external/uxplay" remote="github"
           name="calicopizzadelivery/UxPlay"
           revision="refs/heads/android-jetson-tv" />
  <project path="external/libplist" remote="github"
           name="calicopizzadelivery/libplist"
           revision="refs/heads/android-jetson-tv" />

  <remove-project path="vendor/lineage" optional="true" />
  <project path="vendor/lineage" remote="github"
           name="calicopizzadelivery/android_vendor_lineage"
           revision="refs/heads/lineage-22.2-jetson-tv" />

</manifest>
