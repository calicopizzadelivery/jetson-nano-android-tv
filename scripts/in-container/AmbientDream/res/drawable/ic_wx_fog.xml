     The closed cloud path rather than the open arc the rain icons use: nothing
     falls out of this one, so an open bottom edge just reads as a broken shape.
     Group scale scales the stroke, hence 1.7 / 0.78 below.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateX="3"
        android:translateY="-1">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#E8EEF3"
            android:strokeWidth="2.18"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M18,10h-1.26A8,8 0 1,0 9,20h9a5,5 0 0,0 0,-10z" />
    </group>
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E8EEF3"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M4.5,18h15M7.5,21.8h9" />
</vector>
