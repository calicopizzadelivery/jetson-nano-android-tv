<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Fades in rather than starting at a hard edge, which is visible as a
         line across the picture on anything with detail in the lower half. -->
    <gradient
        android:angle="90"
        android:startColor="#CC000000"
        android:centerColor="#66000000"
        android:endColor="#00000000"
        android:type="linear" />
</shape>
