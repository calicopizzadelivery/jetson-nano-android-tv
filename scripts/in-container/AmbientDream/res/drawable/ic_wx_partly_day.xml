     Composed rather than drawn: the same sun, moon and cloud paths as the
     single-element icons, placed with group transforms. Group scale scales the
     stroke too, so each strokeWidth below is 1.7 divided by that group%27s scale,
     which is what keeps every icon in the set looking like one weight.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- sun, top left, clear of the cloud outline below -->
    <group
        android:scaleX="0.45"
        android:scaleY="0.45"
        android:translateX="0.9"
        android:translateY="0.2">
        <path
            android:fillColor="#E8EEF3"
            android:pathData="M7.4,12a4.6,4.6 0 1,0 9.2,0a4.6,4.6 0 1,0 -9.2,0z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#E8EEF3"
            android:strokeWidth="3.78"
            android:strokeLineCap="round"
            android:pathData="M12,1.2v2.1M12,20.7v2.1M4.4,4.4l1.5,1.5M18.1,18.1l1.5,1.5M1.2,12h2.1M20.7,12h2.1M4.4,19.6l1.5,-1.5M18.1,5.9l1.5,-1.5" />
    </group>

    <group
        android:scaleX="0.7"
        android:scaleY="0.7"
        android:translateX="7"
        android:translateY="8.4">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#E8EEF3"
            android:strokeWidth="2.43"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M18,10h-1.26A8,8 0 1,0 9,20h9a5,5 0 0,0 0,-10z" />
    </group>
</vector>
