<permissions>
    <privapp-permissions package="org.lineageos.tv.ambient">
        <!-- Read every active MediaSession, for the now-playing panel. The
             public alternative is a notification listener, which needs a
             setting the viewer has to go and find. -->
        <permission name="android.permission.MEDIA_CONTENT_CONTROL" />
    </privapp-permissions>
</permissions>
