// SPDX-FileCopyrightText: 2026 The LineageOS Project
// SPDX-License-Identifier: Apache-2.0

// The SPDX comment above documents the licence; it does NOT declare it to
// Soong, so without the block below this module contributes nothing to the
// image's NOTICE file and nothing appears for it under Settings > About >
// Legal information. license_kinds is what the compliance tooling reads;
// license_text is what a user can actually read on the device. This is the
// same defect that left 44 LGPL files in external/uxplay uncredited until
// 2026-10-18.
package {
    default_applicable_licenses: ["vendor_jetson-tv_AmbientDream_license"],
}

license {
    name: "vendor_jetson-tv_AmbientDream_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

android_app {
    name: "AmbientDream",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    product_specific: true,

    // Privileged and platform-signed for MEDIA_CONTENT_CONTROL, which is what
    // lets the now-playing panel see every app's MediaSession rather than
    // only an AirPlay-shaped one. See NowPlaying.java.
    certificate: "platform",
    privileged: true,
    required: ["privapp_whitelist_org.lineageos.tv.ambient"],

    // Leanback for the settings screen's GuidedStep UI, which is what the
    // rest of the TV settings look like. FragmentActivity comes from
    // androidx.fragment rather than appcompat on purpose: an AppCompatActivity
    // would demand an AppCompat theme, and Theme.Leanback.GuidedStep is not one.
    static_libs: [
        "androidx.leanback_leanback",
        "androidx.fragment_fragment",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_org.lineageos.tv.ambient",
    product_specific: true,
    sub_dir: "permissions",
    src: "privapp_whitelist_org.lineageos.tv.ambient.xml",
    filename_from_src: true,
}
