From 9f044a73c3725c39d84c0cb1a5e607705617e391 Mon Sep 17 00:00:00 2001
From: Phil <300208363+calicopizzadelivery@users.noreply.github.com>
Date: Fri, 25 Sep 2026 18:12:39 -0500
Subject: [PATCH] sdk_tv: allow the credentials permission in the artifact path
 requirement

lineage_sdk_tv_x86_64, lineage_sdk_tv_x86 and lineage_sdk_tv_arm all set
PRODUCT_ENFORCE_ARTIFACT_PATH_REQUIREMENTS := relaxed but carry no allowed
list, so building any of them fails immediately:

  vendor/lineage/build/target/product/lineage_sdk_tv_x86_64.mk produces files
  inside device/google/atv/products/atv_generic_system.mk's artifact path
  requirement.
  Offending entries:
  system/etc/permissions/android.software.credentials.xml

lineage_gsi_car_x86_64 and lineage_gsi_car_arm64 already hit this and carry
the entry; the TV products were missed. Add the same line to all three.

Verified: lineage_sdk_tv_x86_64-bp1a-userdebug builds and boots.
Change-Id: I0e408ccd2b48ac651ddffb409d197cdb296ec924
---
 build/target/product/lineage_sdk_tv_arm.mk    | 3 +++
 build/target/product/lineage_sdk_tv_x86.mk    | 3 +++
 build/target/product/lineage_sdk_tv_x86_64.mk | 3 +++
 3 files changed, 9 insertions(+)

diff --git a/build/target/product/lineage_sdk_tv_arm.mk b/build/target/product/lineage_sdk_tv_arm.mk
index 576a4fdb..9addf2fa 100644
--- a/build/target/product/lineage_sdk_tv_arm.mk
+++ b/build/target/product/lineage_sdk_tv_arm.mk
@@ -21,6 +21,9 @@ TARGET_NO_KERNEL_OVERRIDE := true
 # Enable mainline checking
 PRODUCT_ENFORCE_ARTIFACT_PATH_REQUIREMENTS := relaxed
 
+PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
+    system/etc/permissions/android.software.credentials.xml
+
 # Overrides
 PRODUCT_NAME := lineage_sdk_tv_arm
 PRODUCT_MODEL := LineageOS Android TV SDK built for ARM
diff --git a/build/target/product/lineage_sdk_tv_x86.mk b/build/target/product/lineage_sdk_tv_x86.mk
index 616fab08..c7bfd23c 100644
--- a/build/target/product/lineage_sdk_tv_x86.mk
+++ b/build/target/product/lineage_sdk_tv_x86.mk
@@ -22,6 +22,9 @@ TARGET_NO_KERNEL_OVERRIDE := true
 # Enable mainline checking
 PRODUCT_ENFORCE_ARTIFACT_PATH_REQUIREMENTS := relaxed
 
+PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
+    system/etc/permissions/android.software.credentials.xml
+
 # Overrides
 PRODUCT_NAME := lineage_sdk_tv_x86
 PRODUCT_MODEL := LineageOS Android TV SDK built for x86
diff --git a/build/target/product/lineage_sdk_tv_x86_64.mk b/build/target/product/lineage_sdk_tv_x86_64.mk
index 5e26a284..3c642406 100644
--- a/build/target/product/lineage_sdk_tv_x86_64.mk
+++ b/build/target/product/lineage_sdk_tv_x86_64.mk
@@ -21,6 +21,9 @@ TARGET_NO_KERNEL_OVERRIDE := true
 # Enable mainline checking
 PRODUCT_ENFORCE_ARTIFACT_PATH_REQUIREMENTS := relaxed
 
+PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
+    system/etc/permissions/android.software.credentials.xml
+
 # Overrides
 PRODUCT_NAME := lineage_sdk_tv_x86_64
 PRODUCT_MODEL := LineageOS Android TV SDK built for x86_64
-- 
