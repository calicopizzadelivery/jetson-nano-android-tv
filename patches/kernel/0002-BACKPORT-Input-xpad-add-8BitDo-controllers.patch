From 9a0836a164b6da69203383fd8499cbcfb6ea7196 Mon Sep 17 00:00:00 2001
From: Phil <300208363+calicopizzadelivery@users.noreply.github.com>
Date: Thu, 1 Oct 2026 21:55:06 -0500
Subject: [PATCH] BACKPORT: Input: xpad - add 8BitDo controllers

Brings this driver up to upstream's 8BitDo support as of Linux
971fa7ea8621 (2026-09-14). In X-input mode, on a cable or on 8BitDo's
2.4 GHz receiver, their newer pads report 8BitDo's own vendor ID, 0x2dc8,
which this 4.9 xpad did not list, so nothing bound to them and the pad
was dead. This adds:

- the vendor-wide Xbox 360 and Xbox One interface matches for 0x2dc8,
  so xpad claims any 8BitDo pad that presents either interface;
- upstream's seven named entries: 2000 and 200f (Xbox One type), and
  3106, 3109, 310a, 310b and 6001 (Xbox 360 type).

Upstream commits: 21617de3b464 (Pro 2 Wired), ea330429a04b (Ultimate 2C),
66372fa99360 (name of 3106), 36e093c8dcc5 (SN30 Pro), 22cd66a5db56
(Ultimate 2), and the 200f, 3109 and Xbox One vendor-match entries as
they stand in 971fa7ea8621.

Upstream gives 200f MAP_SHARE_BUTTON, which this driver predates. It is
added with no mapping flags, so that pad's Share button is not reported.

Change-Id: If1846e470186622020061ef435f4a708ed9c551f
---
 drivers/input/joystick/xpad.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/input/joystick/xpad.c b/drivers/input/joystick/xpad.c
index 4dc8befc92e4..600870cc9795 100644
--- a/drivers/input/joystick/xpad.c
+++ b/drivers/input/joystick/xpad.c
@@ -230,6 +230,14 @@ static const struct xpad_device {
 	{ 0x24c6, 0x5506, "Hori SOULCALIBUR V Stick", 0, XTYPE_XBOX360 },
 	{ 0x24c6, 0x5b02, "Thrustmaster, Inc. GPX Controller", 0, XTYPE_XBOX360 },
 	{ 0x24c6, 0x5b03, "Thrustmaster Ferrari 458 Racing Wheel", 0, XTYPE_XBOX360 },
+	{ 0x2dc8, 0x2000, "8BitDo Pro 2 Wired Controller fox Xbox", 0, XTYPE_XBOXONE },
+	/* Upstream maps its Share button with MAP_SHARE_BUTTON, which 4.9 lacks. */
+	{ 0x2dc8, 0x200f, "8BitDo Ultimate 3-mode Controller for Xbox", 0, XTYPE_XBOXONE },
+	{ 0x2dc8, 0x3106, "8BitDo Ultimate Wireless / Pro 2 Wired Controller", 0, XTYPE_XBOX360 },
+	{ 0x2dc8, 0x3109, "8BitDo Ultimate Wireless Bluetooth", 0, XTYPE_XBOX360 },
+	{ 0x2dc8, 0x310a, "8BitDo Ultimate 2C Wireless Controller", 0, XTYPE_XBOX360 },
+	{ 0x2dc8, 0x310b, "8BitDo Ultimate 2 Wireless Controller", 0, XTYPE_XBOX360 },
+	{ 0x2dc8, 0x6001, "8BitDo SN30 Pro", 0, XTYPE_XBOX360 },
 	{ 0xffff, 0xffff, "Chinese-made Xbox Controller", 0, XTYPE_XBOX },
 	{ 0x0000, 0x0000, "Generic X-Box pad", 0, XTYPE_UNKNOWN }
 };
@@ -330,6 +338,8 @@ static struct usb_device_id xpad_table[] = {
 	XPAD_XBOX360_VENDOR(0x1689),		/* Razer Onza */
 	XPAD_XBOX360_VENDOR(0x24c6),		/* PowerA Controllers */
 	XPAD_XBOXONE_VENDOR(0x24c6),		/* PowerA Controllers */
+	XPAD_XBOX360_VENDOR(0x2dc8),		/* 8BitDo Controllers */
+	XPAD_XBOXONE_VENDOR(0x2dc8),		/* 8BitDo Controllers */
 	XPAD_XBOX360_VENDOR(0x1532),		/* Razer Sabertooth */
 	XPAD_XBOXONE_VENDOR(0x1532),		/* Razer Wildcat */
 	XPAD_XBOX360_VENDOR(0x15e4),		/* Numark X-Box 360 controllers */
-- 
