From 2a3254a56a6c2253074382592b3cbcc3f61ec3eb Mon Sep 17 00:00:00 2001
From: Phil <300208363+calicopizzadelivery@users.noreply.github.com>
Date: Wed, 30 Sep 2026 19:34:22 -0500
Subject: [PATCH 6/6] android: declare the licences, so the image's notices
 carry them

UxPlay and playfair are GPLv3, llhttp and the ALAC decoder MIT. Without a
license module Soong attached no licence to libuxplay_jni, and the GPLv3
text was missing from the device's legal notices. The ALAC notice is
split out of alac.c into its own file so it can be cited.

Change-Id: Ic0ad7cea4cccbd131459e9efb0eeb639316e219c
---
 Android.bp           | 21 +++++++++++++++++++++
 android/alac/LICENSE | 28 ++++++++++++++++++++++++++++
 2 files changed, 49 insertions(+)
 create mode 100644 android/alac/LICENSE

diff --git a/Android.bp b/Android.bp
index 804d318..4986957 100644
--- a/Android.bp
+++ b/Android.bp
@@ -7,6 +7,27 @@
 //
 // SPDX-License-Identifier: GPL-3.0-or-later
 
+package {
+    default_applicable_licenses: ["external_uxplay_license"],
+}
+
+// UxPlay and playfair are GPLv3 (playfair's LICENSE.md is the same text);
+// llhttp and the ALAC decoder are MIT. All of it ends up in the image's
+// licence notices through this.
+license {
+    name: "external_uxplay_license",
+    visibility: [":__subpackages__"],
+    license_kinds: [
+        "SPDX-license-identifier-GPL-3.0-or-later",
+        "SPDX-license-identifier-MIT",
+    ],
+    license_text: [
+        "LICENSE",
+        "lib/llhttp/LICENSE-MIT",
+        "android/alac/LICENSE",
+    ],
+}
+
 cc_defaults {
     name: "uxplay_defaults",
     cflags: [
diff --git a/android/alac/LICENSE b/android/alac/LICENSE
new file mode 100644
index 0000000..ecc869d
--- /dev/null
+++ b/android/alac/LICENSE
@@ -0,0 +1,28 @@
