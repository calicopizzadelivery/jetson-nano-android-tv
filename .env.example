# Copy to .env and edit. `.env` is gitignored; this file is the template.
#
# Every path below must already exist on the host and be owned by your user.
# scripts/host-setup.sh creates them; by default under /srv/build/jetson-tv.

# ---------------------------------------------------------------------------
# Where the big things live
# ---------------------------------------------------------------------------

# Source tree + out/. LineageOS asks for ~400 GB for lineage-21 and up.
SRC_DIR=/srv/build/jetson-tv/lineage

# Compiler cache. 25-50 GB is plenty for a single device.
CCACHE_DIR=/srv/build/jetson-tv/ccache

# Downloaded NVIDIA archives for blob extraction: L4T r32.7.6 / r32.6.1
# tarballs and SHIELD recovery OTA images. Budget ~20 GB. Kept outside the
# tree so `repo sync` and tree wipes never cost you the re-download.
DL_CACHE_DIR=/srv/build/jetson-tv/dlcache

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# Must match your host user, or everything the build writes lands root-owned.
# Check with: id -u ; id -g
HOST_UID=1000
HOST_GID=1000

# repo will not sync without these.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

# lineage-22.2 is what the official porg nightlies are currently built from.
LINEAGE_BRANCH=lineage-22.2
LINEAGE_DEVICE=porg

CCACHE_SIZE=50G

# Leave blank to let the build system pick. Set it lower if you have under
# 64 GB of RAM — linking is where an AOSP build goes OOM, and the default
# job count assumes plenty of headroom. A reasonable starting point on a
# RAM-constrained box is roughly (RAM in GB / 4).
JOBS=
